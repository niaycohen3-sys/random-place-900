# הגרסה הנוכחית עובדת בלי שום מפתח (Leaflet + OpenStreetMap + Overpass + Nominatim).
# המפתחות כאן נדרשים רק אם מחליפים ספק ל-Google Places (דירוגים ושעות פתיחה מלאים).

# Google Maps / Places API (אופציונלי, לשדרוג עתידי)
# VITE_GOOGLE_MAPS_API_KEY=your_key_here
# GOOGLE_PLACES_API_KEY=your_key_here

# Mapbox (חלופה אופציונלית למפה/גיאוקודינג)
# VITE_MAPBOX_TOKEN=pk.your_token_here
